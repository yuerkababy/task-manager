{
    "permissions": {
        "ask": ["Bash(git commit *)"]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit|Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python .claude/hooks/guard_writes.py",
                        "timeout": 10
                    }
                ]
            },
            {
                "matcher": "Bash|PowerShell",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python .claude/hooks/guard_git.py"
                    }
                ]
            }
        ]
    }
}
